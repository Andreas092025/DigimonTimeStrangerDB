<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigimonDB.App.Pages.DatabasePage"
             Title="Database">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Database Overview"
                   FontSize="28"
                   FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="10">
                <Button x:Name="ImportButton" Text="Import Data" Clicked="OnImportClicked" />
                <ActivityIndicator x:Name="ImportActivity" IsVisible="False" IsRunning="False" />
            </HorizontalStackLayout>

            <Label x:Name="ImportStatusLabel" Text="Use Import Data to load Digimons, Skills, and Items from JSON files." />

            <Border Padding="16" Stroke="#3A3A3A" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Digimon" FontAttributes="Bold" />
                    <Label x:Name="DigimonCountLabel" Text="0" FontSize="22" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" Stroke="#3A3A3A" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Moves" FontAttributes="Bold" />
                    <Label x:Name="MoveCountLabel" Text="0" FontSize="22" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" Stroke="#3A3A3A" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Items" FontAttributes="Bold" />
                    <Label x:Name="ItemCountLabel" Text="0" FontSize="22" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" Stroke="#3A3A3A" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Evolutions" FontAttributes="Bold" />
                    <Label x:Name="EvolutionCountLabel" Text="0" FontSize="22" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
