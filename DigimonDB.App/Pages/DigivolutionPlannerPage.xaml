<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigimonDB.App.Pages.DigivolutionPlannerPage"
             Title="Digivolution Planner">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Digivolution Planner"
                   FontSize="28"
                   FontAttributes="Bold" />

            <Label Text="Select a Digimon to see direct evolutions:" FontAttributes="Bold" />
            <Picker x:Name="FromPicker" Title="From Digimon" SelectedIndexChanged="OnFromChanged" />

            <Label x:Name="DirectStatusLabel" Text="No selection." />
            <CollectionView x:Name="DirectEvolutionCollection" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0,0,0,8" Stroke="#3A3A3A" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding ToName}" FontAttributes="Bold" />
                                <Label Text="{Binding Condition, StringFormat='Condition: {0}'}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="#3A3A3A" Margin="0,8,0,8" />

            <Label Text="Find shortest evolution path:" FontAttributes="Bold" />
            <Picker x:Name="PathStartPicker" Title="Start Digimon" />
            <Picker x:Name="PathTargetPicker" Title="Target Digimon" />
            <Button Text="Find Path" Clicked="OnFindPathClicked" />

            <Label x:Name="PathStatusLabel" Text="Choose start and target." />
            <CollectionView x:Name="PathCollection" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0,0,0,8" Stroke="#3A3A3A" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding StepText}" FontAttributes="Bold" />
                                <Label Text="{Binding ConditionText}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
