<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigimonDB.App.Pages.ItemsPage"
             Title="Items">

    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12">
        <Label Text="Items"
               Grid.Row="0"
               FontSize="28"
               FontAttributes="Bold" />
        
        <Label Text="Items can be crafted by Vulcanusmon. Bring the listed materials to him."
                Grid.Row="1"
                FontSize="14"
                FontAttributes="Italic"
                TextColor="Red" />

        <Label Text="He can be found at the bottom of the Factorial Area."
               Grid.Row="2"
               FontSize="12"
               FontAttributes="Italic"
               TextColor="Red" />

        <SearchBar x:Name="ItemSearchBar"
                   Grid.Row="3"
                   Placeholder="Search by item name, type, or evolution target"
                   TextChanged="OnSearchChanged" />

        <CollectionView x:Name="ItemsCollection"
                        Grid.Row="5"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,0,0,10" Stroke="#3A3A3A" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding Type, StringFormat='Type: {0}'}" />
                            <Label Text="{Binding EvolvesFrom, StringFormat='Evolves From: {0}'}" />
                            <Label Text="{Binding EvolvesTo, StringFormat='Evolves To: {0}'}" />
                            <Label Text="{Binding Description}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
